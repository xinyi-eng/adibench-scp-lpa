# Normalize line endings in the repository.
# Working tree may be CRLF (Windows autocrlf=true), but the repo stores LF.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows (they run under bash)
*.sh text eol=lf

# Binary files — never touch
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.bin binary
*.safetensors binary
*.parquet binary